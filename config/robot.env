# JetArm + SmolVLA project configuration
# Sourced by scripts/env.sh (bash). Edit values here, not in the scripts.

# ---- Robot identity ----
export ROBOT_MODEL="jetarm_advanced"      # Hiwonder JetArm Advanced (6-DOF + tank chassis)
export ARM_DOF=6                          # joint1..joint5 + gripper
export CAMERA_TYPE="GEMINI"               # Orbbec Gemini (depth + RGB)

# ---- ROS2 environment ----
# Runtime vars required by the Hiwonder ros2_ws launch files (.hiwonderrc).
# Exported here instead of sourcing .hiwonderrc (which sets LD_PRELOAD/Open3D
# and zsh-only hooks we do not want).
export need_compile="False"               # use source-tree package paths
export MACHINE_TYPE="JETARM_ADVANCED"
export CHASSIS_TYPE="Tank"
export MICROPHONE_TYPE="xf"
export ASR_LANGUAGE="English"
export ROS_DISTRO_NAME="humble"
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-31}"
export ROS_WS="${HOME}/ros2_ws"
export THIRD_PARTY_ROS2="${HOME}/third_party_ros2"
# CycloneDDS config used by Hiwonder (leave commented if not present)
[ -f /etc/cyclonedds/config.xml ] && export CYCLONEDDS_URI="file:///etc/cyclonedds/config.xml"

# ---- Low-level controller board (STM32 "ros_robot_controller") ----
# The board is a CH340 USB-serial device. Its legacy name is ttyUSB0.
export RRC_PORT="/dev/ttyUSB0"
export RRC_BAUD=1000000

# ---- ROS2 control seams (verified from ros2_ws sources) ----
# Command the arm: publish servo_controller_msgs/msg/ServosPosition
export TOPIC_SERVO_CMD="/servo_controller"
# Read joint feedback (raw pulse + id):
export TOPIC_SERVO_STATES="/controller_manager/servo_states"
# Read joint feedback (radians):
export TOPIC_JOINT_STATES="/controller_manager/joint_states"
# RGB camera used by apps (Orbbec Gemini):
export TOPIC_CAMERA_RGB="/depth_cam/rgb/image_raw"
export TOPIC_CAMERA_DEPTH="/depth_cam/depth/image_raw"
# Low-level read-only service:
export SRV_BUS_SERVO_STATE="/ros_robot_controller/bus_servo/get_state"
# Readiness gates:
export SRV_INIT_FINISH="/controller_manager/init_finish"

# ---- Joint <-> servo id map (pulse 0..1000, 1000 ticks per 240 deg) ----
export JOINT_ORDER="joint1 joint2 joint3 joint4 joint5 gripper"
export JOINT_IDS="1 2 3 4 5 10"
export PULSE_MIN=0
export PULSE_MAX=1000

# ---- Container / ML env (SmolVLA needs py3.12 + torch>=2.7) ----
export JETSON_CONTAINERS="${HOME}/jetson-containers"
export LEROBOT_CONTAINER_TAG="lerobot"        # built from jetson-containers/packages/robots/lerobot
export SMOLVLA_BASE="lerobot/smolvla_base"    # HF base checkpoint to fine-tune
